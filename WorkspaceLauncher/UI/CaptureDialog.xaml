<Window x:Class="WorkspaceLauncher.UI.CaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource BaseWindow}"
        Title="현재 레이아웃 저장" Width="900" Height="580" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/app.ico">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="HeaderText" Text="현재 화면 스냅샷" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14" TextWrapping="Wrap"
                       Text="지금 떠 있는 창의 실행 경로 · 모니터 · 위치 · 크기를 읽었습니다. 저장할 창만 체크하세요. (최소화된 창은 기본 제외)"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="프로필 이름" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <TextBox x:Name="NameBox" Grid.Column="1" Height="32" FontSize="14"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="전체 선택" Style="{StaticResource SmallButton}" Click="SelectAll_Click" Margin="0,0,6,0"/>
                    <Button Content="전체 해제" Style="{StaticResource SmallButton}" Click="SelectNone_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
            <TextBlock x:Name="CountText" DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
            <Button DockPanel.Dock="Right" Content="저장" Style="{StaticResource PrimaryButton}" Width="96" Height="34" IsDefault="True" Click="Save_Click"/>
            <Button DockPanel.Dock="Right" Content="취소" Width="80" Height="34" Margin="0,0,8,0" IsCancel="True"/>
            <Button DockPanel.Dock="Right" Content="↻ 다시 읽기" Height="34" Margin="0,0,8,0" Click="Refresh_Click"/>
        </DockPanel>

        <DataGrid x:Name="Grid" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Click="Check_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="이름" Binding="{Binding Item.Name}" Width="200" IsReadOnly="True"/>
                <DataGridTextColumn Header="유형" Binding="{Binding KindLabel}" Width="72" IsReadOnly="True"/>
                <DataGridTextColumn Header="모니터" Binding="{Binding MonitorLabel}" Width="56" IsReadOnly="True"/>
                <DataGridTextColumn Header="위치 / 크기" Binding="{Binding RectLabel}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="창 제목" Binding="{Binding Window.Title}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
